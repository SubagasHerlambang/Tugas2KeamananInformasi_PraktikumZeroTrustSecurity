{
  "name": "securecampus",
  "version": "1.0.0",
  "private": true,
  "description": "SecureCampus - Zero Trust Academic System (tugas praktikum Keamanan Informasi)",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.js",
    "db:migrate": "node packages/database/cli.js migrate",
    "db:seed": "node packages/database/cli.js seed",
    "db:reset": "node packages/database/cli.js reset",
    "setup": "node scripts/setup-env.js && npm run db:reset",
    "start:gateway": "node apps/gateway/src/server.js",
    "start:nilai": "node apps/nilai-service/src/server.js",
    "start:transkrip": "node apps/transkrip-service/src/server.js",
    "start": "node scripts/start-all.js",
    "audit": "node scripts/audit-cli.js",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.js\" \"tests/integration/*.test.js\" \"tests/security/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:security": "node --test --test-concurrency=1 \"tests/security/*.test.js\"",
    "smoke": "node scripts/smoke.js",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend test",
    "test:all": "npm test && npm run test:frontend && npm run smoke",
    "setup:force": "node scripts/setup-env.js --force && npm run db:reset",
    "setup:random": "node scripts/setup-env.js --force --random-demo && npm run db:reset",
    "frontend:preview": "npm --prefix frontend run preview",
    "db:query": "node scripts/db-query.js",
    "db:summary": "node packages/database/cli.js summary"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "http-proxy-middleware": "^3.0.7",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  }
}
