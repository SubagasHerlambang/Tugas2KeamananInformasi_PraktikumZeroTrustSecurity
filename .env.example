# ============================================================================
# SecureCampus - contoh konfigurasi (HANYA PLACEHOLDER, bukan secret aktif).
# Salin menjadi .env lalu isi nilai rahasia, atau jalankan: npm run setup
# (npm run setup membuat .env dengan secret acak lokal secara otomatis).
# PERHATIAN: nilai yang mengandung karakter '#' HARUS diberi tanda kutip ("..."), karena dotenv
# memperlakukan '#' pada nilai tak berkutip sebagai awal komentar dan memotong nilainya.
# ============================================================================
NODE_ENV=development
BIND_HOST=127.0.0.1

PORT_GATEWAY=3000
PORT_NILAI=3001
PORT_TRANSKRIP=3002

# URL internal. Service Nilai memanggil sinkronisasi LEWAT gateway (bukan langsung ke 3002).
GATEWAY_BASE_URL=http://127.0.0.1:3000
NILAI_URL=http://127.0.0.1:3001
TRANSKRIP_URL=http://127.0.0.1:3002

DATABASE_PATH=./data/securecampus.sqlite

# --- Rahasia (WAJIB diganti; jangan di-commit) ---
JWT_SIGNING_SECRET=<isi-minimal-32-karakter-acak>
JWT_ISSUER=securecampus-local
JWT_AUDIENCE=securecampus-api
GATEWAY_SECRET=<isi-minimal-24-karakter-acak>
SERVICE_NILAI_CLIENT_ID=service-nilai
SERVICE_NILAI_CLIENT_SECRET=<isi-minimal-16-karakter-acak>

# --- Masa berlaku token (nilai wajib dari tugas: 10m / 1d / 5m) ---
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=1d
SERVICE_TOKEN_TTL=5m

# --- Jam akses perubahan/finalisasi nilai (mulai inklusif, akhir eksklusif) ---
ACCESS_WINDOW_START=07:00
ACCESS_WINDOW_END=21:00
ACCESS_TIMEZONE=Asia/Jakarta

# --- Seed demo (HANYA LOKAL/PRAKTIKUM) ---
SEED_DEMO_PASSWORD=<password-demo-lokal>
BCRYPT_COST=10

# --- Hardening ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MS=60000
UPSTREAM_TIMEOUT_MS=10000
FINALIZE_LOCK_TIMEOUT_MS=60000
LOG_LEVEL=info
